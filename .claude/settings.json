{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(php artisan make:*)",
      "Bash(php artisan migrate)",
      "Bash(php artisan migrate --seed)",
      "Bash(php artisan migrate:status)",
      "Bash(php artisan route:list*)",
      "Bash(php artisan config:clear)",
      "Bash(php artisan cache:clear)",
      "Bash(php artisan view:clear)",
      "Bash(php artisan optimize:clear)",
      "Bash(php artisan db:seed*)",
      "Bash(php artisan test*)",
      "Bash(php artisan about)",
      "Bash(composer install*)",
      "Bash(composer update*)",
      "Bash(composer require*)",
      "Bash(composer dump-autoload*)",
      "Bash(./vendor/bin/pint*)",
      "Bash(npm install*)",
      "Bash(npm ci)",
      "Bash(npm run *)",
      "Bash(npx tsc*)",
      "Bash(docker compose *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(gh issue *)",
      "Bash(gh pr create*)",
      "Bash(gh pr view*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr list*)",
      "Bash(gh project item-*)",
      "Bash(gh run *)",
      "Bash(gh pr merge*)"
    ],
    "deny": [
      "Bash(php artisan migrate:fresh*)",
      "Bash(php artisan migrate:reset*)",
      "Bash(php artisan migrate:rollback*)",
      "Bash(php artisan db:wipe*)",
      "Bash(docker compose down -v*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(gh repo delete*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)"
    ]
  }
}
